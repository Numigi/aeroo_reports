<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="aeroo_report_view_form" model="ir.ui.view">
        <field name="name">ir.actions.report.form.aeroo</field>
        <field name="model">ir.actions.report</field>
        <field name="inherit_id" ref="base.view_ir_actions_report_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='report_type']" position="after">
                <field name="aeroo_mimetype_id"
                       invisible="report_type != 'aeroo'"
                       required="report_type == 'aeroo'" />
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Aeroo" invisible="report_type != 'aeroo'">
                    <group>
                        <group string="Template Options">
                            <field name="aeroo_out_format_id" />
                            <field name="aeroo_multi_lang" />
                            <field name="aeroo_template_source" required="report_type == 'aeroo'" />
                            <field name="aeroo_template_path"
                                   invisible="aeroo_template_source != 'file'"
                                   required="aeroo_template_source == 'file'" />
                        </group>
                        <group string="Output Options">
                            <field name="aeroo_deferred" />
                            <field name="aeroo_tz_method" />
                        </group>
                    </group>
                    <group string="Templates" invisible="aeroo_template_source != 'database'">
                        <field name="aeroo_template_line_ids" nolabel="1">
                            <list string="Templates" editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="company_id" groups="base.group_multi_company" />
                                <field name="lang_id" />
                                <field name="template_data" filename="template_filename" />
                                <field name="template_filename" column_invisible="True" />
                            </list>
                        </field>
                    </group>
                    <group string="Generated Filenames">
                        <field name="aeroo_filename_line_ids" nolabel="1">
                            <list string="Filenames" editable="bottom">
                                <field name="sequence" widget="handle" />
                                <field name="company_id" groups="base.group_multi_company" />
                                <field name="lang_id" />
                                <field name="filename" />
                            </list>
                        </field>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
